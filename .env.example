# oa2 environment template — copy to .env and fill in
# Same credentials as v1 OptionsAgents; oa2 reads its own .env

# Broker (moomoo only for v2; Alpaca deferred)
BROKER=moomoo
MOOMOO_USERNAME=
MOOMOO_PASSWORD=
MOOMOO_ACCOUNT_ID=
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# Sentiment sources (optional but recommended)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=oa2/0.1

# LLM (deferred until Phase 1 ports debaters)
ANTHROPIC_API_KEY=

# Runtime
TRADINGBOT_HOME=
OA2_LOG_LEVEL=INFO
OA2_DETAIL_LOGGING=false  # Set to 'true' for verbose pipeline logging (each debater, consensus calibration, sizing gate details)

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Daemon watchdog (optional — alerts if daemon heartbeat stale)
WATCHDOG_STALE_SECONDS=300      # Alert if daemon doesn't update for N seconds (default 5 min)
WATCHDOG_MAX_ALERTS=5           # Max alerts per recovery cycle (default 5)
WATCHDOG_INTERVAL_SECONDS=300   # How often watchdog loop checks (default 5 min, ignored if cron'd)
WATCHDOG_HEALTH_INTERVAL=3600   # Send periodic "all clear" confirmation every N seconds (default 1 hour; set to 0 to disable)

# Exit engine configuration
TRAILING_STOP_PCT=0.10          # Trailing stop: close if P&L drops X% from peak (default 10%), floored at entry loss

# Docker-specific configuration
# When running in Docker, use these values; override in docker-compose.yml environment section
MOOMOO_OPEND_HOST=127.0.0.1     # Set to 'host.docker.internal' when running in Docker Desktop on Windows/Mac
OA2_SUBMIT_ORDERS=0             # 0=paper trading (no real orders), 1=submit real orders to broker
OA2_TRADE_ENV=SIMULATE          # SIMULATE or REAL (controls Kelly sizing aggressiveness)

# Advanced: Paper trading and execution
OA2_ACCOUNT_SIZE=50000          # Initial account size in dollars (default 50000)
OA2_FLOW_SOURCE=yfinance        # Data source for flow debater: yfinance | unusual_whales | tradier | options_whale
OA2_MONITOR_LOCK_PORT=18500     # Port used by daemon for instance lock (prevents duplicate daemons)