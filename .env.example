# oa2 environment template — copy to .env and fill in
# Same credentials as v1 OptionsAgents; oa2 reads its own .env

# Broker (moomoo only for v2; Alpaca deferred)
BROKER=moomoo
MOOMOO_USERNAME=
MOOMOO_PASSWORD=
MOOMOO_ACCOUNT_ID=
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111

# Sentiment sources (optional but recommended)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=oa2/0.1

# LLM (deferred until Phase 1 ports debaters)
ANTHROPIC_API_KEY=

# Runtime
OA2_HOME=
OA2_LOG_LEVEL=INFO
OA2_DETAIL_LOGGING=false  # Set to 'true' for verbose pipeline logging (each debater, consensus calibration, sizing gate details)